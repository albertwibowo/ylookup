# OpenRouter (required for LLM propose/patch during build; heuristic fallback if unset)
OPENROUTER_API_KEY=
# Use a thinking/reasoning model to see reasoning tokens, e.g.:
#   qwen/qwen3-235b-a22b-thinking-2507
# (qwen/qwen3-235b-a22b-2507 is Instruct — no reasoning tokens)
OPENROUTER_MODEL=qwen/qwen3-235b-a22b-thinking-2507
# Reasoning tokens stream to stderr when the model supports them (max/xhigh/high/medium/low/minimal/none)
OPENROUTER_REASONING_EFFORT=medium

# Builder budgets
MAX_BUILD_ITERS=3
MAX_ASK_ROUNDS=3
MAX_QUESTIONS_PER_ROUND=5
